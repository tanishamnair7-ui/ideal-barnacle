# Database URL
# For local development with PostgreSQL:
# DATABASE_URL="postgresql://user:password@localhost:5432/relationship_profile?schema=public"

# For Vercel deployment:
# This will be automatically set by Vercel Postgres
# DATABASE_URL="your-vercel-postgres-url"

# For local development with SQLite (original setup):
# DATABASE_URL="file:./prisma/dev.db"
# Note: Change datasource provider in schema.prisma to "sqlite" for this to work
